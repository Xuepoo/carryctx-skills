{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carryctx.xuepoo.xyz/schemas/preset.schema.json",
  "title": "CarryCtx Preset Manifest",
  "description": "Schema for the JSON manifests shipped in the CarryCtx preset library.",
  "oneOf": [
    {
      "title": "Structured preset manifest",
      "type": "object",
      "required": ["name", "version", "description", "carryctx", "permissions"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "carryctx": {
          "type": "object",
          "required": ["engine"],
          "properties": { "engine": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "workflows": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "permissions": { "$ref": "#/$defs/permissions" }
      },
      "additionalProperties": false
    },
    {
      "title": "Legacy lightweight rule manifest",
      "type": "object",
      "required": ["name", "type", "description", "author", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^rules/[a-z0-9_-]+$" },
        "type": { "const": "rule" },
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "required": ["source", "target", "kind"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["rule", "workflow", "persona"] }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "required": ["requires_filesystem", "requires_network", "requires_env"],
      "properties": {
        "requires_filesystem": { "type": "boolean" },
        "requires_network": { "type": "boolean" },
        "requires_env": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
